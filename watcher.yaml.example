# ============================================================
# hermes-repo-watcher 配置示例
# 放置位置: ~/.hermes/repo-watcher/watcher.yaml
# ============================================================

# 监控的 GitHub 仓库列表
repos:
  - wtofelix-glitch/hermes-repo-watcher   # 先监控自己
  # - wtofelix-glitch/your-other-project

# 轮询间隔（分钟）
interval: 30

# 事件处理器
handlers:
  # ----- PR 事件 -----
  pull_request:
    - name: review-code
      "on": [opened, synchronize]           # 新PR / 新push到PR
      action: claude-code                 # 派 Claude Code 审查
      template: pr-review                 # 用 pr-review.md 模板
      auto_confirm: false                 # 等涛哥确认再执行

    # - name: auto-feature
    #   on: [opened]
    #   action: claude-code
    #   template: pr-feature
    #   auto_confirm: true                # 简单 feature 自动执行

  # ----- Issue 事件 -----
  issues:
    - name: triage
      "on": [opened]
      action: notify                      # 新 Issue 推微信通知
      template: issue-triage

  # ----- Push 事件 -----
  push:
    - name: quick-check
      "on": [main]                           # main 分支 push
      action: codex                        # 派 Codex CLI 做快速检查
      template: commit-check
      auto_confirm: true                   # push 后自动跑

# ----- 通知配置 -----
notify:
  channel: weixin
  "on":
    - handler:done                         # handler 执行完通知
    - handler:needs_decision               # 需要涛哥决策的通知
    - error                                # 出错了通知
